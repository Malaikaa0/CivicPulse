{
  "components": {
    "schemas": {
      "CacheOut": {
        "properties": {
          "hit_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hit Rate"
          },
          "hits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hits"
          },
          "misses": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Misses"
          }
        },
        "required": [
          "hits",
          "misses",
          "hit_rate"
        ],
        "title": "CacheOut",
        "type": "object"
      },
      "Category": {
        "enum": [
          "water",
          "electricity",
          "sanitation",
          "roads",
          "streetlights",
          "other"
        ],
        "title": "Category",
        "type": "string"
      },
      "ComplaintCreate": {
        "properties": {
          "location": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Location",
            "type": "string"
          },
          "reporter_contact": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporter Contact"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 10,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "location"
        ],
        "title": "ComplaintCreate",
        "type": "object"
      },
      "ComplaintOut": {
        "properties": {
          "ai_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Summary"
          },
          "allowed_transitions": {
            "description": "Statuses this complaint may move to next; the frontend keeps no copy of the rules.",
            "items": {
              "$ref": "#/components/schemas/Status"
            },
            "readOnly": true,
            "title": "Allowed Transitions",
            "type": "array"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "reporter_contact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporter Contact"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "triage_latency_ms": {
            "title": "Triage Latency Ms",
            "type": "integer"
          },
          "triaged_by": {
            "$ref": "#/components/schemas/TriagedBy"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "location",
          "reporter_contact",
          "category",
          "priority",
          "status",
          "ai_summary",
          "triaged_by",
          "triage_latency_ms",
          "created_at",
          "updated_at",
          "allowed_transitions"
        ],
        "title": "ComplaintOut",
        "type": "object"
      },
      "ComplaintPageOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ComplaintOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "ComplaintPageOut",
        "type": "object"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "OutcomeOut": {
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "fallback": {
            "title": "Fallback",
            "type": "boolean"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "integer"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "latency_ms",
          "fallback",
          "at"
        ],
        "title": "OutcomeOut",
        "type": "object"
      },
      "Priority": {
        "enum": [
          "high",
          "normal",
          "low"
        ],
        "title": "Priority",
        "type": "string"
      },
      "ProvidersOut": {
        "properties": {
          "active_provider": {
            "title": "Active Provider",
            "type": "string"
          },
          "cache": {
            "$ref": "#/components/schemas/CacheOut"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "outcome_store_available": {
            "title": "Outcome Store Available",
            "type": "boolean"
          },
          "recent_outcomes": {
            "items": {
              "$ref": "#/components/schemas/OutcomeOut"
            },
            "title": "Recent Outcomes",
            "type": "array"
          },
          "vendor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vendor"
          }
        },
        "required": [
          "active_provider",
          "vendor",
          "model",
          "recent_outcomes",
          "cache",
          "outcome_store_available"
        ],
        "title": "ProvidersOut",
        "type": "object"
      },
      "Stats": {
        "description": "Every enum value is always present, with 0 when there are no rows, so clients need not\nfill gaps.",
        "properties": {
          "by_category": {
            "additionalProperties": {
              "minimum": 0.0,
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Category"
            },
            "title": "By Category",
            "type": "object"
          },
          "by_priority": {
            "additionalProperties": {
              "minimum": 0.0,
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Priority"
            },
            "title": "By Priority",
            "type": "object"
          },
          "by_status": {
            "additionalProperties": {
              "minimum": 0.0,
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Status"
            },
            "title": "By Status",
            "type": "object"
          },
          "total": {
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "by_category",
          "by_priority",
          "by_status"
        ],
        "title": "Stats",
        "type": "object"
      },
      "Status": {
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "rejected"
        ],
        "title": "Status",
        "type": "string"
      },
      "StatusChange": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusChange",
        "type": "object"
      },
      "TransitionConflictOut": {
        "properties": {
          "current": {
            "$ref": "#/components/schemas/Status"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "requested": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "detail",
          "current",
          "requested"
        ],
        "title": "TransitionConflictOut",
        "type": "object"
      },
      "TriagedBy": {
        "enum": [
          "llm:groq",
          "llm:gemini",
          "llm:ollama",
          "rules",
          "rules:fallback"
        ],
        "title": "TriagedBy",
        "type": "string"
      },
      "ValidationErrorOut": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ValidationErrorOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "CivicPulse API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/complaints": {
      "get": {
        "operationId": "list_complaints_api_complaints_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Category"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Priority"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Status"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 1000000,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintPageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorOut"
                }
              }
            },
            "description": "Field-level validation errors"
          }
        },
        "summary": "List Complaints",
        "tags": [
          "complaints"
        ]
      },
      "post": {
        "operationId": "create_complaint_api_complaints_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComplaintCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorOut"
                }
              }
            },
            "description": "Field-level validation errors"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Too many submissions from this client; see the Retry-After header"
          }
        },
        "summary": "Create Complaint",
        "tags": [
          "complaints"
        ]
      }
    },
    "/api/complaints/{complaint_id}": {
      "get": {
        "operationId": "get_complaint_api_complaints__complaint_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "complaint_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Complaint Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorOut"
                }
              }
            },
            "description": "Field-level validation errors"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No complaint with that id"
          }
        },
        "summary": "Get Complaint",
        "tags": [
          "complaints"
        ]
      }
    },
    "/api/complaints/{complaint_id}/status": {
      "patch": {
        "operationId": "change_complaint_status_api_complaints__complaint_id__status_patch",
        "parameters": [
          {
            "in": "path",
            "name": "complaint_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Complaint Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplaintOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorOut"
                }
              }
            },
            "description": "Field-level validation errors"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No complaint with that id"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransitionConflictOut"
                }
              }
            },
            "description": "Transition not allowed"
          }
        },
        "summary": "Change Complaint Status",
        "tags": [
          "complaints"
        ]
      }
    },
    "/api/meta/providers": {
      "get": {
        "operationId": "providers_api_meta_providers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
