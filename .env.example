# Copy to .env and fill in real values. .env is gitignored; this file is committed
# and must contain placeholders only - never a real key or password.
# Frontend/Compose note: these values are read by compose.yaml's backend service via ${VAR} substitution.

# --- PostgreSQL ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civicpulse
# Service name (postgres), never localhost, for container-to-container traffic
DATABASE_URL=postgresql+psycopg://civicpulse:change-me@postgres:5432/civicpulse

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- AI triage: simulated | rules | llm | ollama ---
TRIAGE_PROVIDER=simulated
TRIAGE_TIMEOUT_SECONDS=10
TRIAGE_CACHE_TTL_SECONDS=86400

# LLMTriage: one provider class, two vendors (both are OpenAI-compatible). Used when
# TRIAGE_PROVIDER=llm. Only the vendor you choose needs a key. Keys go in .env or a secret
# store, never in a committed file. Check the vendor's live free-tier limits before relying on them.
LLM_VENDOR=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=your-model-name-here

# OllamaTriage (offline path)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=your-model-name-here

# --- API behaviour ---
STATS_CACHE_TTL_SECONDS=30
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Only true when a proxy you run (the ingress) overwrites X-Forwarded-For with the real client IP.
TRUST_FORWARDED_FOR=false
LOG_LEVEL=INFO

# --- Deployment (compose.prod.yaml) ---
IMAGE_TAG=set-to-a-commit-sha
