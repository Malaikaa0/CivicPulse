# Version control and virtualenvs
.git
.gitignore
.venv
venv

# Secrets - must never be baked into an image
.env
.env.*

# Python caches and tooling output.
# The **/ prefix matters: without it Docker only matches these at the context root, and
# app/__pycache__ from the host would be copied into the image.
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Tests, dev dependencies and docs are not needed at runtime
tests
requirements-dev.in
requirements-dev.txt
requirements.in
*.md
Dockerfile
.dockerignore
