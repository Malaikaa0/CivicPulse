# Measured on this checkout (Get-ChildItem -Recurse | Measure-Object Length -Sum), the same
# machine, same commit: without this file, the build context is ~220MB, almost entirely
# .venv/ (~175MB) and .mypy_cache/ (~43MB) - neither of which the image needs or should contain.
# With it, the context is ~1-2MB: app/, alembic/, alembic.ini, requirements.txt. Over 99% smaller,
# and every megabyte of it is something a fresh venv/mypy run recreates in seconds anyway.

# Version control and virtualenvs
.git
.gitignore
.venv
venv

# Secrets - must never be baked into an image
.env
.env.*

# Python caches and tooling output.
# The **/ prefix matters: without it Docker only matches these at the context root, and
# app/__pycache__ from the host would be copied into the image.
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Tests, dev dependencies and docs are not needed at runtime
tests
requirements-dev.in
requirements-dev.txt
requirements.in
*.md
Dockerfile
.dockerignore
